# Nusxa oling: cp .env.example .env   (.env git’ga kiritilmaydi)
# Bu qiymatlar faqat lokal ishlab chiqish uchun. Serverda HAR BIRINI o‘zgartiring.
# Parollarda faqat harf, raqam va _ ishlating (ular URL ichiga qo‘yiladi).

# Gateway hostdagi porti
CRYSTAL_PUBLISH_PORT=8000
# DEBUG | INFO | WARNING | ERROR
CRYSTAL_LOG_LEVEL=INFO

# Har bir servisning alohida bazasi
AUTH_DB_PASSWORD=auth_dev_password
ORDER_DB_PASSWORD=order_dev_password
COURIER_DB_PASSWORD=courier_dev_password
TRACKING_DB_PASSWORD=tracking_dev_password

# JWT imzo kaliti (kamida 32 belgi). Yaratish: openssl rand -base64 48
CRYSTAL_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# Birinchi ishga tushishda yaratiladigan admin
CRYSTAL_ADMIN_USERNAME=admin
CRYSTAL_ADMIN_PASSWORD=admin_dev_password
# Access token muddati (soniya)
CRYSTAL_ACCESS_TOKEN_TTL_S=900

# RabbitMQ
RABBITMQ_USER=crystal
RABBITMQ_PASSWORD=crystal_dev_password
RABBITMQ_UI_PORT=15672
